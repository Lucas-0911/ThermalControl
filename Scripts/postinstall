#!/bin/bash
# Installer executes its own packaged script, never a mutable app resource as root.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
APP="/Applications/Thermal Control.app"
HELPER_SRC="$APP/Contents/MacOS/ThermalControlHelper"

if [[ ! -x "$HELPER_SRC" ]]; then
  echo "Không thấy helper trong app: $HELPER_SRC" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec /bin/bash "$SCRIPT_DIR/install_helper.sh" "$HELPER_SRC" "$APP"
